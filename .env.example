# Application Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Storage
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://rateguard:rateguard@localhost:5432/rateguard

# Authentication Tokens (replace with secure random tokens in production)
SERVICE_TOKEN=replace_with_service_token
ADMIN_TOKEN=replace_with_admin_token

# Synchronization and Intervals
CONFIG_POLL_INTERVAL_MS=3000
FLUSHER_INTERVAL_MS=5000
LOG_LEVEL=info

# Rate Limiting Constraints
MAX_COST=100
MAX_ROUTE_LENGTH=500
REDIS_TIMEOUT_MS=250
